    "dprov": "https://w3id.org/decision-prov#",
    "@vocab": "https://w3id.org/decision-prov#",
    "DecisionRecord": "dprov:DecisionRecord",
    "ActionBindingAttachment": "dprov:ActionBindingAttachment",
